  "metrics": [
    {
      "interpretation": "number of deterministic axial bins",
      "method": "180 / configured bin width",
      "metric_name": "orientation_bin_count",
      "population": "both axial distributions",
      "units": "bins",
      "value": 36,
      "weighting": "not applicable"
    },
    {
      "interpretation": "axial histogram bin width",
      "method": "180 / bins",
      "metric_name": "orientation_bin_width_degrees",
      "population": "both axial distributions",
      "units": "degrees",
      "value": 5.0,
      "weighting": "not applicable"
    },
    {
      "interpretation": "overall endpoint-to-endpoint street axes",
      "method": "one chord orientation per eligible edge",
      "metric_name": "chord_orientation_observation_count",
      "population": "positive-chord physical edges",
      "units": "physical streets",
      "value": 69,
      "weighting": "equal physical edge"
    },
    {
      "interpretation": "local geometry orientations including internal curvature",
      "method": "one orientation per positive geometry segment",
      "metric_name": "segment_orientation_observation_count",
      "population": "LineString geometry segments",
      "units": "segments",
      "value": 76,
      "weighting": "segment length"
    },
    {
      "interpretation": "raw Shannon orientation entropy",
      "method": "-sum(p_i * ln(p_i))",
      "metric_name": "chord_orientation_entropy",
      "population": "36-bin chord orientations",
      "units": "nats",
      "value": 0.8233712721085531,
      "weighting": "equal physical edge"
    },
    {
      "interpretation": "maximum possible entropy for configured bins",
      "method": "ln(number_of_bins)",
      "metric_name": "chord_orientation_maximum_entropy",
      "population": "36-bin chord orientations",
      "units": "nats",
      "value": 3.58351893845611,
      "weighting": "not applicable"
    },
    {
      "interpretation": "orientation disorder normalized to [0,1]",
      "method": "H / ln(number_of_bins)",
      "metric_name": "chord_orientation_normalized_entropy",
      "population": "36-bin chord orientations",
      "units": "proportion",
      "value": 0.22976612828040105,
      "weighting": "equal physical edge"
    },
    {
      "interpretation": "raw length-weighted Shannon orientation entropy",
      "method": "-sum(p_i * ln(p_i))",
      "metric_name": "segment_length_weighted_orientation_entropy",
      "population": "36-bin geometry-segment orientations",
      "units": "nats",
      "value": 0.6896030136902007,
      "weighting": "segment_length_local"
    },
    {
      "interpretation": "maximum possible entropy for configured bins",
      "method": "ln(number_of_bins)",
      "metric_name": "segment_orientation_maximum_entropy",
      "population": "36-bin geometry-segment orientations",
      "units": "nats",
      "value": 3.58351893845611,
      "weighting": "not applicable"
    },
    {
      "interpretation": "length-weighted orientation disorder normalized to [0,1]",
      "method": "H / ln(number_of_bins)",
      "metric_name": "segment_length_weighted_normalized_entropy",
      "population": "36-bin geometry-segment orientations",
      "units": "proportion",
      "value": 0.19243738502113314,
      "weighting": "segment_length_local"
    },
    {
      "interpretation": "fourfold orthogonal orientation order",
      "method": "|sum(w*exp(i*4*theta))/sum(w)|",
      "metric_name": "phi_chord",
      "population": "positive-chord physical edges",
      "units": "proportion",
      "value": 0.9511069268378259,
      "weighting": "equal physical edge"
    },
    {
      "interpretation": "length-weighted fourfold local-orientation order",
      "method": "|sum(w*exp(i*4*theta))/sum(w)|",
      "metric_name": "phi_segment_length_weighted",
      "population": "positive LineString geometry segments",
      "units": "proportion",
      "value": 1.0,
      "weighting": "segment_length_local"
    }
  ],
